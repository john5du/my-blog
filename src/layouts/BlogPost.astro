---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={title} description={description} image={heroImage} />
		<style>
			main {
				width: min(100% - 2rem, 820px);
			}

			article {
				display: grid;
				gap: 2rem;
			}

			article > * {
				min-width: 0;
			}

			.article-header {
				padding-bottom: 1.5rem;
				border-bottom: 1px solid var(--line);
			}

			.meta {
				display: flex;
				gap: 0.75rem;
				flex-wrap: wrap;
				margin-bottom: 0.85rem;
				color: rgb(var(--muted));
				font-family: var(--font-mono);
				font-size: 0.85rem;
			}

			.article-header h1 {
				margin-bottom: 0.85rem;
				font-size: 2.1rem;
				overflow-wrap: anywhere;
			}

			.description {
				width: min(100%, 680px);
				margin: 0;
				color: rgb(var(--muted));
				font-size: 1.02rem;
			}

			.hero-image img {
				display: block;
				border: 1px solid var(--line);
				border-radius: 6px;
			}

			.prose {
				width: 100%;
				max-width: 100%;
			}

			:global(.prose > *:first-child) {
				margin-top: 0;
			}

			:global(.prose h2) {
				padding-top: 0.4rem;
				border-top: 1px solid var(--line);
			}

			:global(.prose a) {
				font-weight: 600;
			}

			:global(.prose p),
			:global(.prose ul),
			:global(.prose ol) {
				color: rgb(var(--ink));
			}

			:global(.prose li::marker) {
				color: var(--accent);
			}

			@media (max-width: 640px) {
				main {
					width: min(100% - 1.25rem, 820px);
				}

				.meta {
					gap: 0.35rem;
					flex-direction: column;
				}

				.article-header h1 {
					font-size: 1.7rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<article>
				<header class="article-header">
					<div class="meta">
						<FormattedDate date={pubDate} />
						{
							updatedDate && (
								<span>
									更新于 <FormattedDate date={updatedDate} />
								</span>
							)
						}
					</div>
					<h1>{title}</h1>
					<p class="description">{description}</p>
				</header>
				{heroImage && <div class="hero-image"><Image width={1020} height={510} src={heroImage} alt="" /></div>}
				<div class="prose">
					<slot />
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
