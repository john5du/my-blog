---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_PATHS, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			.hero {
				display: grid;
				gap: 1.5rem;
				padding: 3rem 0 2rem;
				border-bottom: 1px solid var(--line);
			}

			.kicker {
				margin: 0;
				color: var(--accent);
				font-family: var(--font-mono);
				font-size: 0.9rem;
			}

			h1 {
				max-width: 11em;
				margin: 0;
			}

			.lede {
				max-width: 660px;
				margin: 0;
				color: rgb(var(--muted));
				font-size: 1.08rem;
			}

			.actions {
				display: flex;
				gap: 0.75rem;
				flex-wrap: wrap;
			}

			.actions a {
				display: inline-flex;
				align-items: center;
				min-height: 2.4rem;
				padding: 0.45rem 0.75rem;
				border: 1px solid var(--line);
				border-radius: 4px;
				background: var(--paper-raised);
				color: rgb(var(--ink));
				font-family: var(--font-mono);
				font-size: 0.9rem;
				text-decoration: none;
			}

			.actions a:first-child {
				border-color: rgba(15, 118, 110, 35%);
				background: var(--accent-soft);
				color: #115e59;
			}

			.latest {
				padding-top: 3rem;
			}

			.section-head {
				display: flex;
				align-items: end;
				justify-content: space-between;
				gap: 1rem;
				margin-bottom: 1rem;
			}

			.section-head h2 {
				margin: 0;
				font-size: 1.2rem;
			}

			.section-head a {
				font-family: var(--font-mono);
				font-size: 0.9rem;
				text-decoration: none;
			}

			.post-list {
				display: grid;
				gap: 0;
				margin: 0;
				padding: 0;
				list-style: none;
				border-top: 1px solid var(--line);
			}

			.post-list li {
				margin: 0;
				border-bottom: 1px solid var(--line);
			}

			.post-list a {
				display: grid;
				grid-template-columns: 8.5rem 1fr;
				gap: 1.25rem;
				padding: 1.1rem 0;
				color: inherit;
				text-decoration: none;
			}

			.post-list a:hover h3 {
				color: var(--accent);
			}

			.date {
				color: rgb(var(--muted));
				font-family: var(--font-mono);
				font-size: 0.85rem;
			}

			.post-list h3 {
				margin: 0 0 0.25rem;
				font-size: 1.08rem;
			}

			.post-list p {
				margin: 0;
				color: rgb(var(--muted));
				font-size: 0.95rem;
			}

			@media (max-width: 640px) {
				.hero {
					padding-top: 1.5rem;
				}

				.section-head {
					align-items: flex-start;
					flex-direction: column;
				}

				.post-list a {
					grid-template-columns: 1fr;
					gap: 0.4rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<p class="kicker">~/notes</p>
				<h1>{SITE_TITLE}</h1>
				<p class="lede">
					{SITE_DESCRIPTION}
				</p>
				<div class="actions">
					<a href={SITE_PATHS.blog}>阅读文章</a>
					<a href={SITE_PATHS.rss}>订阅 RSS</a>
				</div>
			</section>

			<section class="latest" aria-labelledby="latest-posts">
				<div class="section-head">
					<h2 id="latest-posts">最新记录</h2>
					<a href={SITE_PATHS.blog}>全部文章</a>
				</div>
				<ul class="post-list">
					{
						posts.map((post) => (
							<li>
								<a href={SITE_PATHS.post(post.id)}>
									<div class="date">
										<FormattedDate date={post.data.pubDate} />
									</div>
									<div>
										<h3>{post.data.title}</h3>
										<p>{post.data.description}</p>
									</div>
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>
