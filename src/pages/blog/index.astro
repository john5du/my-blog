---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_PATHS, SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const pageTitle = `文章 / ${SITE_TITLE}`;
const pageDescription = '技术笔记归档。';
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={pageTitle} description={pageDescription} />
		<style>
			.archive-header {
				padding-bottom: 1.75rem;
				border-bottom: 1px solid var(--line);
			}

			.archive-header p {
				max-width: 620px;
				margin: 0.5rem 0 0;
				color: rgb(var(--muted));
			}

			.count {
				color: var(--accent);
				font-family: var(--font-mono);
				font-size: 0.9rem;
			}

			.post-list {
				display: grid;
				gap: 0;
				margin: 1.5rem 0 0;
				padding: 0;
				list-style: none;
			}

			.post-list li {
				margin: 0;
				border-bottom: 1px solid var(--line);
			}

			.post-list li:first-child {
				border-top: 1px solid var(--line);
			}

			.post-list a {
				display: grid;
				grid-template-columns: 8.5rem 1fr;
				gap: 1.25rem;
				padding: 1.2rem 0;
				color: inherit;
				text-decoration: none;
			}

			.post-list a:hover h2 {
				color: var(--accent);
			}

			.date {
				color: rgb(var(--muted));
				font-family: var(--font-mono);
				font-size: 0.85rem;
			}

			.post-list h2 {
				margin: 0 0 0.35rem;
				font-size: 1.22rem;
			}

			.post-list p {
				margin: 0;
				color: rgb(var(--muted));
				font-size: 0.98rem;
			}

			@media (max-width: 640px) {
				.post-list a {
					grid-template-columns: 1fr;
					gap: 0.4rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="archive-header">
				<p class="count">{posts.length} posts</p>
				<h1>文章</h1>
				<p>把折腾过程、部署笔记和踩坑记录留在这里，方便以后再次找到线索。</p>
			</section>
			<ul class="post-list">
				{
					posts.map((post) => (
						<li>
							<a href={SITE_PATHS.post(post.id)}>
								<div class="date">
									<FormattedDate date={post.data.pubDate} />
								</div>
								<div>
									<h2>{post.data.title}</h2>
									<p>{post.data.description}</p>
								</div>
							</a>
						</li>
					))
				}
			</ul>
		</main>
		<Footer />
	</body>
</html>
