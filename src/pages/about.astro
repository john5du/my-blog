---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';

const title = `关于 / ${SITE_TITLE}`;
const description = '关于这个技术笔记站。';
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			.about {
				max-width: 720px;
			}

			.kicker {
				margin: 0 0 0.75rem;
				color: var(--accent);
				font-family: var(--font-mono);
				font-size: 0.9rem;
			}

			.about h1 {
				margin-bottom: 1rem;
			}

			.about p {
				color: rgb(var(--muted));
			}

			.note {
				margin-top: 2rem;
				padding: 1rem;
				border: 1px solid var(--line);
				border-radius: 6px;
				background: var(--paper-raised);
			}

			.note p {
				margin: 0;
				color: rgb(var(--ink));
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="about">
				<p class="kicker">whoami</p>
				<h1>关于</h1>
				<p>
					这里是「{SITE_TITLE}」，一个用来整理部署记录、智能家居折腾、容器化实践和日常技术笔记的小站。
				</p>
				<p>
					内容会尽量保留真实步骤和命令，少一点包装，多一点以后能直接复用的线索。
				</p>
				<div class="note">
					<p>文章按时间倒序归档，RSS 也会同步输出。</p>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>
