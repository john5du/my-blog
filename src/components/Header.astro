---
import { SITE_PATHS, SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header class="site-header">
	<nav aria-label="主导航">
		<a class="brand" href={SITE_PATHS.home}>
			<span class="prompt">$</span>
			<span>{SITE_TITLE}</span>
		</a>
		<div class="internal-links">
			<HeaderLink href={SITE_PATHS.home}>首页</HeaderLink>
			<HeaderLink href={SITE_PATHS.blog}>文章</HeaderLink>
			<HeaderLink href={SITE_PATHS.about}>关于</HeaderLink>
		</div>
	</nav>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 10;
		border-bottom: 1px solid var(--line);
		background: rgba(251, 252, 248, 92%);
		backdrop-filter: blur(14px);
	}

	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		width: min(100% - 2rem, 980px);
		min-height: 64px;
		margin: auto;
		gap: 1rem;
	}

	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		color: rgb(var(--ink));
		font-family: var(--font-mono);
		font-size: 1rem;
		font-weight: 700;
		text-decoration: none;
	}

	.prompt {
		color: var(--accent);
	}

	.internal-links {
		display: flex;
		align-items: center;
		gap: 0.25rem;
	}

	.internal-links a {
		padding: 0.45rem 0.65rem;
		border-radius: 4px;
		color: rgb(var(--muted));
		font-size: 0.95rem;
		text-decoration: none;
	}

	.internal-links a:hover,
	.internal-links a.active {
		background: var(--accent-soft);
		color: #115e59;
	}

	@media (max-width: 560px) {
		nav {
			width: min(100% - 1rem, 980px);
			min-height: auto;
			padding: 0.75rem 0;
			align-items: flex-start;
			flex-direction: column;
		}

		.internal-links {
			width: 100%;
			justify-content: space-between;
		}

		.internal-links a {
			padding-inline: 0.45rem;
		}
	}
</style>
