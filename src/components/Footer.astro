---
import { SITE_PATHS, SITE_TITLE } from '../consts';

const today = new Date();
---

<footer>
	<div>
		<span>&copy; {today.getFullYear()} {SITE_TITLE}</span>
		<span class="divider">/</span>
		<a href={SITE_PATHS.rss}>RSS</a>
	</div>
</footer>

<style>
	footer {
		border-top: 1px solid var(--line);
		padding: 2rem 1rem 3rem;
		color: rgb(var(--muted));
		font-family: var(--font-mono);
		font-size: 0.85rem;
		text-align: center;
	}

	footer div {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.6rem;
		flex-wrap: wrap;
	}

	footer a {
		color: var(--accent);
		text-decoration: none;
	}

	footer a:hover {
		text-decoration: underline;
	}

	.divider {
		color: rgb(var(--muted));
	}
</style>
